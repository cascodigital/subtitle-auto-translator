# ==========================================
# Subtitle Auto Translator Configuration
# ==========================================

# Google Gemini API Key (Get a free API key at https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Model Selection & Performance
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_MAX_CHARS=2500
GEMINI_TIMEOUT=180
GEMINI_RETRIES=3

# Language Settings (Default: English to Brazilian Portuguese)
SOURCE_LANG=en
TARGET_LANG=pt-BR
SOURCE_LANG_NAME=English
TARGET_LANG_NAME=Brazilian Portuguese

# Offline Fallback (LibreTranslate container)
LIBRETRANSLATE_SOURCE=en
LIBRETRANSLATE_TARGET=pt

# Operational Flags
PROCESS_EXISTING_SOURCE_ONLY=0

# Extra Media Directories (optional, colon-separated paths, e.g. /extra1:/extra2)
# EXTRA_MEDIA_DIRS=
